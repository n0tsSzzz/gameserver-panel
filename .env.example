# Postgres
POSTGRES_USER=gamehost
POSTGRES_PASSWORD=gamehost
POSTGRES_DB=gamehost
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# API
DATABASE_URL=postgresql+asyncpg://gamehost:gamehost@localhost:5432/gamehost

# API auth
SECRET_KEY=dev-only-change-me-32bytes-min-aaaaa
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Stage 2 — bootstrap first admin
BOOTSTRAP_ADMIN_EMAIL=admin@gh.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-prod

# Stage 4 — async worker
REDIS_URL=redis://localhost:6379
NODE_AGENT_TIMEOUT_S=10.0

# Stage 6 — invites
API_PUBLIC_URL=http://localhost:8000
INVITE_TTL_DAYS=7

# Stage 7 — backups (node-agent → MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gamehost-backups
S3_REGION=us-east-1
